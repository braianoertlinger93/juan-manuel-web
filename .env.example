# ============================================================
# VARIABLES DE ENTORNO — copiá este archivo como ".env"
# y completá los valores reales desde tu proyecto de Supabase.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).
# ============================================================

# Proyecto Supabase: https://supabase.com/dashboard -> Settings -> API
# URL del proyecto (columna "Project URL").
SUPABASE_URL=

# Anon public key. ES PÚBLICA por diseño: solo permite lectura y,
# junto con las políticas RLS, lo que el admin autenticado haga.
SUPABASE_ANON_KEY=

# Service role key. NUNCA debe llegar al frontend.
# Se usa SOLO en el servidor (api/) para insertar mensajes de contacto.
SUPABASE_SERVICE_ROLE_KEY=

# Puerto local (opcional, por defecto 3000).
# PORT=3000

# Correo de WhatsApp/Contacto se edita desde el panel de administración.
